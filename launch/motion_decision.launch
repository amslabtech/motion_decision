<?xml version="1.0"?>
<launch>
    <arg name="ns" default="local_planner"/>
    <arg name="output" default="log" doc="screen or log"/>

    <!-- MotionDecisionParams -->
    <arg name="enable_turbo_mode" default="false"/>
    <arg name="hz" default="20"/>
    <arg name="allowable_num_of_not_received_local_path" default="1"/>
    <arg name="max_velocity" default="1.0"/>
    <arg name="turbo_max_velocity" default="1.66"/>
    <arg name="max_yawrate" default="1.0"/>
    <!-- Published topic -->
    <arg name="cmd_vel" default="cmd_vel"/>
    <!-- Subscribed topics -->
    <arg name="local_path/cmd_vel" default="local_path/cmd_vel"/>

    <!-- run motion_decision node -->
    <node pkg="motion_decision" type="motion_decision" name="motion_decision" output="$(arg output)" respawn="true">
        <!-- MotionDecisionParams -->
        <param name="enable_turbo_mode" value="$(arg enable_turbo_mode)"/>
        <param name="hz" value="$(arg hz)"/>
        <param name="allowable_num_of_not_received_local_path" value="$(arg allowable_num_of_not_received_local_path)"/>
        <param name="max_velocity" value="$(arg max_velocity)"/>
        <param name="turbo_max_velocity" value="$(arg turbo_max_velocity)"/>
        <param name="max_yawrate" value="$(arg max_yawrate)"/>
        <!-- Published topic -->
        <remap from="cmd_vel" to="$(arg cmd_vel)"/>
        <!-- Subscribed topics -->
        <remap from="local_path/cmd_vel" to="$(arg local_path/cmd_vel)"/>
    </node>
</launch>
